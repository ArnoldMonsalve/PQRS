<UserControl x:Class="PQRS.Desktop.Views.Admin.TiposAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DataGrid ItemsSource="{Binding Tipos}" SelectedItem="{Binding Seleccionado}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Prefijo" Binding="{Binding Prefijo}" Width="70"/>
                <DataGridTextColumn Header="Días" Binding="{Binding DiasRespuesta}" Width="60"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo, Mode=OneWay}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Tipo de solicitud" Style="{StaticResource Seccion}"/>

                <TextBlock Text="Nombre *" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>

                <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                <TextBlock Text="Prefijo del radicado * (1 a 5 letras o números)" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding Prefijo, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" CharacterCasing="Upper"/>

                <TextBlock Text="Días hábiles para responder *" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding DiasRespuesta, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/>

                <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,12,0,0"/>

                <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="22,7"/>
                    <Button Content="Nuevo" Command="{Binding NuevoCommand}" Padding="22,7" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
