<UserControl x:Class="PQRS.Desktop.Views.RadicarSolicitudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Seccion">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,2"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="5"/></Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Radicar nueva solicitud" FontSize="22" FontWeight="Bold"/>

            <!-- Datos de la solicitud -->
            <TextBlock Text="Datos de la solicitud" Style="{StaticResource Seccion}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tipo *" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSeleccionado}" DisplayMemberPath="Nombre"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Categoría *" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" DisplayMemberPath="Nombre"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Canal de recepción" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Canales}" SelectedItem="{Binding Canal}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Prioridad" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Prioridades}" SelectedItem="{Binding Prioridad}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Asunto *" Style="{StaticResource Etiqueta}"/>
            <TextBox Text="{Binding Asunto, UpdateSourceTrigger=PropertyChanged}" MaxLength="250"/>
            <TextBlock Text="Descripción *" Style="{StaticResource Etiqueta}"/>
            <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto"/>

            <!-- Solicitante -->
            <TextBlock Text="Solicitante" Style="{StaticResource Seccion}"/>
            <CheckBox Content="Solicitud anónima" IsChecked="{Binding EsAnonima}" Margin="0,6,0,0"/>

            <StackPanel Visibility="{Binding MostrarSolicitante, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tipo de documento" Style="{StaticResource Etiqueta}"/>
                        <ComboBox ItemsSource="{Binding TiposDocumento}" SelectedItem="{Binding TipoDocumento}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Número de documento *" Style="{StaticResource Etiqueta}"/>
                        <TextBox Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nombres *" Style="{StaticResource Etiqueta}"/>
                        <TextBox Text="{Binding Nombres, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apellidos" Style="{StaticResource Etiqueta}"/>
                        <TextBox Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Correo electrónico" Style="{StaticResource Etiqueta}"/>
                        <TextBox Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="250"/>
            </StackPanel>

            <!-- Mensajes y acciones -->
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
                <Button Content="Radicar" Command="{Binding RadicarCommand}" Padding="28,9" FontSize="14" IsDefault="False"/>
                <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Padding="22,9" FontSize="14" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
