<Window x:Class="PQRS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PQRS - Iniciar sesión" Height="380" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Sistema PQRS" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Inicie sesión para continuar" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,4,0,24"/>

            <TextBlock Text="Usuario" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsuario" Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" FontSize="14"/>

            <TextBlock Text="Contraseña" Margin="0,14,0,4"/>
            <PasswordBox x:Name="TxtClave" Padding="6" FontSize="14" PasswordChanged="TxtClave_PasswordChanged"/>

            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Button Content="Ingresar" Command="{Binding IngresarCommand}" IsDefault="True"
                    Padding="0,9" FontSize="14" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Window>
