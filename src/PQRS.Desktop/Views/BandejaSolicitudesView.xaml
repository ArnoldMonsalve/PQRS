<UserControl x:Class="PQRS.Desktop.Views.BandejaSolicitudesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Bandeja de solicitudes" FontSize="22" FontWeight="Bold"/>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="12" Background="#F3F5F8" CornerRadius="4">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,8" Width="230">
                        <TextBlock Text="Buscar (radicado, asunto, documento)" Style="{StaticResource Etiqueta}"/>
                        <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" Padding="5"
                                 KeyDown="TxtBuscar_KeyDown"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" Width="170">
                        <TextBlock Text="Estado" Style="{StaticResource Etiqueta}"/>
                        <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoFiltro}"
                                  DisplayMemberPath="Texto" Padding="5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" Width="160">
                        <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}"/>
                        <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoFiltro}"
                                  DisplayMemberPath="Nombre" Padding="5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" Width="130">
                        <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                        <DatePicker SelectedDate="{Binding Desde}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" Width="130">
                        <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                        <DatePicker SelectedDate="{Binding Hasta}"/>
                    </StackPanel>
                    <CheckBox Content="Solo vencidas" IsChecked="{Binding SoloVencidas}" VerticalAlignment="Bottom" Margin="0,0,14,12"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Buscar" Command="{Binding BuscarCommand}" Padding="22,6" IsDefault="True"/>
                    <Button Content="Limpiar" Command="{Binding LimpiarFiltrosCommand}" Padding="18,6" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Pie: resumen y abrir -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Abrir solicitud" Command="{Binding AbrirCommand}" Padding="20,7"/>
            <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Listado -->
        <DataGrid Margin="0,12,0,0" ItemsSource="{Binding Solicitudes}" SelectedItem="{Binding Seleccionada}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Vencida}" Value="True">
                            <Setter Property="Background" Value="#FDECEA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Radicado" Binding="{Binding Radicado}" Width="130"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="95"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="140"/>
                <DataGridTextColumn Header="Asunto" Binding="{Binding Asunto}" Width="*"/>
                <DataGridTextColumn Header="Solicitante" Binding="{Binding Solicitante}" Width="150"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado, Converter={StaticResource EstadoTexto}}" Width="150"/>
                <DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="80"/>
                <DataGridTextColumn Header="Vence" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
