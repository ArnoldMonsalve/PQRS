<UserControl x:Class="PQRS.Desktop.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tarjeta de indicador -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="#F3F5F8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="170"/>
        </Style>
        <Style x:Key="Cifra" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
        </Style>

        <!-- Lista de barras: etiqueta, barra proporcional y cantidad -->
        <DataTemplate x:Key="FilaConteo">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Etiqueta}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Porcentaje, Mode=OneWay}"
                             Height="14" Margin="8,0" Foreground="#2F6DB5"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Run Text="{Binding Cantidad, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Porcentaje, StringFormat=' ({0:0.#}%)', Mode=OneWay}" Foreground="Gray"/>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Reportes" FontSize="22" FontWeight="Bold"/>

            <!-- Filtros -->
            <WrapPanel Margin="0,14,0,0">
                <StackPanel Margin="0,0,14,8" Width="140">
                    <TextBlock Text="Desde" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding Desde}"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,8" Width="140">
                    <TextBlock Text="Hasta" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding Hasta}"/>
                </StackPanel>
                <Button Content="Generar" Command="{Binding GenerarCommand}" Padding="22,6"
                        VerticalAlignment="Bottom" Margin="0,0,10,8" IsDefault="True"/>
                <Button Content="Exportar a Excel" Command="{Binding ExportarCommand}" Padding="18,6"
                        VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            </WrapPanel>

            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <StackPanel Visibility="{Binding HayResumen, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <!-- Indicadores -->
                <WrapPanel DataContext="{Binding Resumen}">
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel><TextBlock Text="{Binding Total}" Style="{StaticResource Cifra}"/>
                            <TextBlock Text="Total de solicitudes" Foreground="Gray"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel><TextBlock Text="{Binding Abiertas}" Style="{StaticResource Cifra}"/>
                            <TextBlock Text="Abiertas" Foreground="Gray"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Background="#FDECEA">
                        <StackPanel><TextBlock Text="{Binding Vencidas}" Style="{StaticResource Cifra}" Foreground="#C62828"/>
                            <TextBlock Text="Vencidas" Foreground="Gray"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel><TextBlock Text="{Binding Respondidas}" Style="{StaticResource Cifra}"/>
                            <TextBlock Text="Respondidas o cerradas" Foreground="Gray"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel><TextBlock Text="{Binding Anuladas}" Style="{StaticResource Cifra}"/>
                            <TextBlock Text="Anuladas" Foreground="Gray"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="{Binding PromedioDiasRespuesta, StringFormat={}{0:0.#}, TargetNullValue=—}" Style="{StaticResource Cifra}"/>
                            <TextBlock Text="Días promedio de respuesta" Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="{Binding PorcentajeATiempo, StringFormat={}{0:0.#}%, TargetNullValue=—}" Style="{StaticResource Cifra}"/>
                            <TextBlock Text="Respondidas a tiempo" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Distribuciones -->
                <StackPanel DataContext="{Binding Resumen}">
                    <TextBlock Text="Por estado" FontSize="16" FontWeight="Bold" Margin="0,12,0,4"/>
                    <ItemsControl ItemsSource="{Binding PorEstado}" ItemTemplate="{StaticResource FilaConteo}"/>

                    <TextBlock Text="Por tipo de solicitud" FontSize="16" FontWeight="Bold" Margin="0,20,0,4"/>
                    <ItemsControl ItemsSource="{Binding PorTipo}" ItemTemplate="{StaticResource FilaConteo}"/>

                    <TextBlock Text="Por categoría" FontSize="16" FontWeight="Bold" Margin="0,20,0,4"/>
                    <ItemsControl ItemsSource="{Binding PorCategoria}" ItemTemplate="{StaticResource FilaConteo}"/>

                    <TextBlock Text="Por área" FontSize="16" FontWeight="Bold" Margin="0,20,0,4"/>
                    <ItemsControl ItemsSource="{Binding PorArea}" ItemTemplate="{StaticResource FilaConteo}"/>
                </StackPanel>
                <Border Height="24"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
