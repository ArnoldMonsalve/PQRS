<UserControl x:Class="PQRS.Desktop.Views.DetalleSolicitudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,8,0,1"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Seccion">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="5"/></Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding}">
            <Button Content="← Volver a la bandeja" Command="{Binding IrAtrasCommand}"
                    HorizontalAlignment="Left" Padding="12,5"/>

            <StackPanel DataContext="{Binding Detalle}" Margin="0,14,0,0">
                <!-- Encabezado -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Resumen.Radicado}" FontSize="24" FontWeight="Bold"/>
                    <Border Background="#1F3A5F" CornerRadius="10" Padding="10,2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Resumen.Estado, Converter={StaticResource EstadoTexto}}" Foreground="White"/>
                    </Border>
                    <Border Background="#C62828" CornerRadius="10" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Resumen.Vencida, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Vencida" Foreground="White"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Resumen.Asunto}" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Resumen.Tipo}"/>
                        <TextBlock Text="Categoría" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Resumen.Categoria}"/>
                        <TextBlock Text="Canal" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Canal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Área" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Resumen.Area, TargetNullValue=Sin asignar}"/>
                        <TextBlock Text="Responsable" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Responsable, TargetNullValue=Sin asignar}"/>
                        <TextBlock Text="Prioridad" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Resumen.Prioridad}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Radicada" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Resumen.FechaRadicacion, StringFormat=dd/MM/yyyy HH:mm}"/>
                        <TextBlock Text="Vence" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding Resumen.FechaVencimiento, StringFormat=dd/MM/yyyy}"/>
                        <TextBlock Text="Cierre" Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text="{Binding FechaCierre, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=—}"/>
                    </StackPanel>
                </Grid>

                <!-- Solicitante -->
                <TextBlock Text="Solicitante" Style="{StaticResource Seccion}"/>
                <TextBlock Text="Solicitud anónima" FontStyle="Italic"
                           Visibility="{Binding DataContext.EsAnonima, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <StackPanel DataContext="{Binding Solicitante}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nombres}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Apellidos}" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TipoDocumento}"/>
                        <TextBlock Text="{Binding NumeroDocumento}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Correo}"/>
                    <TextBlock Text="{Binding Telefono}"/>
                    <TextBlock Text="{Binding Direccion}"/>
                </StackPanel>

                <!-- Descripción -->
                <TextBlock Text="Descripción" Style="{StaticResource Seccion}"/>
                <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/>

                <!-- Respuestas -->
                <TextBlock Text="Respuestas" Style="{StaticResource Seccion}"/>
                <ItemsControl ItemsSource="{Binding Respuestas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EAF4EA" Padding="10" Margin="0,0,0,8" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Usuario, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}" Foreground="Gray"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Contenido}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Aún no hay respuestas." Foreground="Gray"
                           Visibility="{Binding DataContext.SinRespuestas, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Acciones -->
            <TextBlock Text="Acciones" Style="{StaticResource Seccion}"/>
            <TextBlock Text="{Binding MensajeError}" Foreground="#C62828" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding MensajeExito}" Foreground="#2E7D32" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <StackPanel Visibility="{Binding PuedeAsignar, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                <TextBlock Text="Asignar responsable" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox ItemsSource="{Binding Responsables}" SelectedItem="{Binding ResponsableSeleccionado}"
                              DisplayMemberPath="Nombre" Width="280"/>
                    <Button Content="Asignar" Command="{Binding AsignarCommand}" Padding="18,5" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding PuedeCambiarEstado, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="Cambiar estado" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding EstadosSiguientes}" SelectedItem="{Binding EstadoSeleccionado}"
                          Width="280" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EstadoTexto}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Motivo / comentario (obligatorio para anular o pedir información)" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding ComentarioEstado, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                <Button Content="Cambiar estado" Command="{Binding CambiarEstadoCommand}" Padding="18,5"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Visibility="{Binding PuedeResponder, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="Responder al solicitante" FontWeight="SemiBold"/>
                <TextBox Text="{Binding TextoRespuesta, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,4,0,0"/>
                <Button Content="Enviar respuesta" Command="{Binding ResponderCommand}" Padding="18,5"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Visibility="{Binding PuedeComentar, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="Agregar comentario" FontWeight="SemiBold"/>
                <TextBox Text="{Binding TextoComentario, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,4,0,0"/>
                <CheckBox Content="Comentario interno (no visible para el solicitante)" IsChecked="{Binding ComentarioInterno}" Margin="0,6,0,0"/>
                <Button Content="Agregar comentario" Command="{Binding ComentarCommand}" Padding="18,5"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Adjuntos -->
            <TextBlock Text="Adjuntos" Style="{StaticResource Seccion}"/>
            <ListBox ItemsSource="{Binding Adjuntos}" SelectedItem="{Binding AdjuntoSeleccionado}"
                     MaxHeight="170" MinHeight="40" MouseDoubleClick="Adjuntos_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="0,2">
                            <TextBlock DockPanel.Dock="Right" Foreground="Gray" Margin="16,0,0,0"
                                       Text="{Binding TamanoBytes, Converter={StaticResource TamanoArchivo}}"/>
                            <TextBlock DockPanel.Dock="Right" Foreground="Gray" Margin="16,0,0,0"
                                       Text="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"/>
                            <TextBlock Text="{Binding NombreArchivo}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Agregar archivo" Command="{Binding AgregarAdjuntoCommand}" Padding="16,5"
                        Visibility="{Binding PuedeComentar, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Abrir" Command="{Binding AbrirAdjuntoCommand}" Padding="16,5" Margin="10,0,0,0"/>
                <Button Content="Eliminar" Command="{Binding EliminarAdjuntoCommand}" Padding="16,5" Margin="10,0,0,0"
                        Visibility="{Binding PuedeGestionar, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Text="Se permiten PDF, Word, Excel, PowerPoint, texto, imágenes y ZIP de hasta 10 MB."
                       Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>

            <!-- Historial -->
            <TextBlock Text="Historial" Style="{StaticResource Seccion}"/>
            <ItemsControl ItemsSource="{Binding Detalle.Seguimientos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDE1E7" BorderThickness="0,0,0,1" Padding="0,8">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}" Foreground="Gray"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Usuario, Mode=OneWay, TargetNullValue=Sistema}" FontWeight="SemiBold"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding EstadoNuevo, Converter={StaticResource EstadoTexto}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Comentario}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="Interno" Foreground="#B26A00" FontSize="11"
                                           Visibility="{Binding EsInterno, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="24"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
