<Window x:Class="PQRS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema PQRS" Height="720" Width="1100" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Background="#1F3A5F" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" Padding="12,4"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding UsuarioActual}" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding NombreOrganizacion}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Menú lateral -->
        <Border DockPanel.Dock="Left" Width="190" Background="#F3F5F8" BorderBrush="#DDE1E7" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <Button Content="Bandeja de solicitudes" Command="{Binding NavegarBandejaCommand}"
                        Padding="10,9" HorizontalContentAlignment="Left"/>
                <Button Content="Nueva solicitud" Command="{Binding NavegarRadicarCommand}"
                        Padding="10,9" HorizontalContentAlignment="Left" Margin="0,6,0,0"/>
                <Button Content="Reportes" Command="{Binding NavegarReportesCommand}"
                        Padding="10,9" HorizontalContentAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding PuedeVerReportes, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Administración" Command="{Binding NavegarAdministracionCommand}"
                        Padding="10,9" HorizontalContentAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <ContentControl Content="{Binding VistaActual}"/>
    </DockPanel>
</Window>
